{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "build" }
    },
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    // Всё, что /api/xxx → наш FastAPI
    { "src": "/api/(.*)", "dest": "/backend/main.py" },
    // Остальное (/, /login, /my-orders и т.д.) → статические файлы React
    { "src": "/(.*)",      "dest": "/frontend/build/$1" }
  ]
}
